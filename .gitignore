# Flutter / Dart
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/.packages
app/*.iml
app/.idea/

# Windows build output
app/windows/flutter/ephemeral/
dist/
*.exe
*.pdb
*.ilk
*.exp
*.lib
*.obj

# Local personalisation — never committed
app_config.local.json
app/assets/config/app_config.local.json
app/assets/branding/local/
app/assets/languages/local/

# Release signing — never committed
app/android/key.properties
*.jks
*.keystore

# Analysis artefacts that may contain user data
*.hive
*.hive.lock
local_dump/
hive_dump*.json

# OS / editor
.DS_Store
Thumbs.db
*.swp
.vscode/

# Python bytecode from tools/
__pycache__/
*.pyc
